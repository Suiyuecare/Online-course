# 公開網址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PRESENCE_INTERVAL_SECONDS=120

# Supabase（Auth Email OTP + Google，後台服務金鑰只限伺服器）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# 積分課敏感資料 AES-256-GCM 金鑰（32 bytes，base64 或 64 位 hex；正式環境建立後不可任意更換）
LEARNER_DATA_ENCRYPTION_KEY=

# Cloudflare Stream（影片須設定 requireSignedURLs）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# 綠界全方位金流測試環境
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_CHECKOUT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# 綠界 MIG 4.0 電子發票（企業統編買受人）
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=
ECPAY_INVOICE_ENV=stage

# Zoom Server-to-Server OAuth + Meeting SDK（直播會議由歲悅帳戶主持）
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# Zoom 會議密碼 AES-256-GCM 金鑰（32 bytes，base64 或 64 位 hex）
LIVE_SECRET_ENCRYPTION_KEY=

# Resend 購課確認與課前提醒
RESEND_API_KEY=
RESEND_FROM_EMAIL=歲悅學苑 <course@example.com>
CRON_SECRET=

# 功能開關依階段逐一完成內部驗證後開啟
FEATURE_LIVE_COURSES=false
FEATURE_ACCREDITATION_EXPORT=true
FEATURE_ENTERPRISE=false
