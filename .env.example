# Safe public browser configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=
NEXT_PUBLIC_ZOOM_MEETING_SDK_KEY=

# Runtime mode. Local provider adapters require BOTH development and
# ALLOW_LOCAL_MOCK_PROVIDERS=true. They are rejected in production.
APP_ENV=development
ALLOW_LOCAL_MOCK_PROVIDERS=false

# Server-only Supabase and abuse controls
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
IDENTITY_RISK_ENDPOINT=
IDENTITY_RISK_TOKEN=
IDENTITY_RECOVERY_ENDPOINT=
IDENTITY_RECOVERY_TOKEN=
CRON_SECRET=
RATE_LIMIT_HMAC_SECRET=
BANK_IMPORT_HMAC_SECRET=

# PII encryption. Production uses a managed KMS adapter, not a raw KEK here.
PII_KMS_PROVIDER=
PII_KMS_KEY_ID=
PII_KMS_ENDPOINT=
PII_KMS_ACCESS_TOKEN=
PII_BLIND_INDEX_KEY_CURRENT=
PII_BLIND_INDEX_KEY_PREVIOUS=
ORGANIZATION_INVITATION_BLIND_INDEX_KEY=
LOCAL_KMS_MASTER_KEY=

# Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
VIDEO_MASTER_BACKUP_ENDPOINT=
VIDEO_MASTER_BACKUP_TOKEN=

# Zoom Server-to-Server OAuth, Meeting SDK, and webhooks
ZOOM_ACCOUNT_ID=
# Must be the Meeting SDK app owner account and exactly match ZOOM_ACCOUNT_ID.
ZOOM_MEETING_SDK_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_MEETING_SDK_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_SECRET_ENCRYPTION_KEY=

# Notification delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
EMAIL_VERIFICATION_HMAC_SECRET=
LOCAL_EMAIL_VERIFICATION_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Certificate PDF renderer. Production endpoint must return application/pdf.
CERTIFICATE_RENDERER_ENDPOINT=
CERTIFICATE_RENDERER_TOKEN=
CERTIFICATE_ISSUING_PERSON_ID=

# Quarantine scanner/sanitizer. It must validate MIME and magic bytes, reject
# malware/zip bombs, and return sanitized bytes for promotion.
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=

# External operations settings. Missing values keep commerce closed.
LEGAL_ENTITY_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
SUPPORT_PHONE=
SUPPORT_EMAIL=
BANK_NAME=
BANK_CODE=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
FINANCE_HIGH_VALUE_REVIEW_THRESHOLD_TWD=
INCIDENT_OWNER=

# Emergency switches. Database feature switches are authoritative; these may
# only close a capability earlier and can never force one open.
EMERGENCY_DISABLE_ALL=true
EMERGENCY_DISABLE_PAYMENTS=true
EMERGENCY_DISABLE_EXPORTS=true
EMERGENCY_DISABLE_CERTIFICATES=true
